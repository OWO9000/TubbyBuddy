<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is allowed so a laptop/LAN backend (http://192.168.x.x:port or the emulator's 10.0.2.2) works in demos.
     Use an https:// public URL for anything real. -->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
  <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration" />
</network-security-config>
