# Copy to .env (never commit .env).
# Meta Model API key from https://dev.meta.ai (API keys tab). Every AI feature runs on it:
# Tubby's chat and greeting, block-screen nudges, visit-photo checks and reward art.
# Left empty, the app runs offline: fixed coach lines and nudges, labelled "demo coach" in the UI.
META_MODEL_API_KEY=

# Google OAuth Web client id for "Continue with Google" (not a secret; no client secret needed).
# Left empty, there is no sign-in and every browser or phone keeps a guest profile.
GOOGLE_CLIENT_ID=

# Optional overrides
PORT=8787
META_BASE_URL=https://api.meta.ai/v1
META_TEXT_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
# Where SQLite + uploaded media live (default: backend/data, backend/media)
DATA_DIR=
MEDIA_DIR=
# Set to false to disable the demo "+500 points" grant
ALLOW_DEMO_GRANTS=true

# ---- Abuse controls ----
# Write rate limits (per device id, falling back to IP). Real clients write rarely.
# Set RATE_LIMITS=off to disable (load tests only).
RATE_LIMITS=
RATE_LIMIT_WRITES_PER_HOUR=600
RATE_LIMIT_EARN_PER_HOUR=240
RATE_LIMIT_BURN_PER_HOUR=240
RATE_LIMIT_UNLOCK_PER_HOUR=30
RATE_LIMIT_REDEEM_PER_HOUR=30
RATE_LIMIT_BUY_PER_HOUR=60
# Set to true when hosted behind a reverse proxy so limits key on the real client IP
TRUST_PROXY=false
